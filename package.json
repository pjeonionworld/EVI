{
  "name": "evi",
  "version": "0.1.0",
  "private": true,
  "description": "EVI - a pixel NPC desktop AI agent",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --publish=never"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "dev.eon.evi",
    "productName": "EVI",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json",
      "!assets/npc/source/**",
      "!assets/environment/source/**",
      "!data/**"
    ],
    "asar": true,
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "EVI.exe"
    }
  }
}
